# Copy this file to .env and fill in the values printed at the end of the AWS
# deploy (see docs/AWS.md): `npx cdk deploy` lists them under Outputs.
#
# EXPO_PUBLIC_ variables are inlined into the app bundle, so only put values
# here that are safe to ship to clients. None of these are secrets: the API is
# protected by Cognito tokens and row-level security, not by these values.

# MatLogStack.ApiUrl
EXPO_PUBLIC_API_URL=https://abc123.execute-api.us-east-1.amazonaws.com
# MatLogStack.Region
EXPO_PUBLIC_COGNITO_REGION=us-east-1
# MatLogStack.UserPoolClientId
EXPO_PUBLIC_COGNITO_CLIENT_ID=your-app-client-id

# Food search (optional but recommended). Get a free key in a minute at
# https://fdc.nal.usda.gov/api-key-signup. Without one, the app uses USDA's
# shared DEMO_KEY, which only allows a few searches per hour.
EXPO_PUBLIC_USDA_API_KEY=
