# Copy this file to .env and fill in the values from your Supabase project:
# Dashboard > Project Settings > API (or `npx supabase status` for local dev).
#
# EXPO_PUBLIC_ variables are inlined into the app bundle, so only put values
# here that are safe to ship to clients. Never put the service_role / secret
# key in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Food search (optional but recommended). Get a free key in a minute at
# https://fdc.nal.usda.gov/api-key-signup. Without one, the app uses USDA's
# shared DEMO_KEY, which only allows a few searches per hour.
EXPO_PUBLIC_USDA_API_KEY=
