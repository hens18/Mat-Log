    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "3.8.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "db:types": "npx supabase gen types typescript --db-url postgres://master:master-local-pw@localhost:55432/matlog --schema public > src/types/database.ts && prettier --write src/types/database.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "start:tunnel": "expo start --tunnel",
    "aws:local": "cd infra && npx tsx test/local-stack.ts up .local"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/infra/"
    ],
    "moduleDirectories": [
      "node_modules",
      "node_modules/expo/node_modules"
    ]
  }
